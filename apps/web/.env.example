# Copy to apps/web/.env.local and fill in. Never commit the real file.
# Every NEXT_PUBLIC_* value is bundled into browser code, so only public values go here.

# Base URL of the NestJS API, including the /api prefix
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Public URL of this site; used to build the OAuth redirect link (/auth/callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Dashboard -> Project Settings -> API Keys -> Publishable key (sb_publishable_...)
# Safe for the browser: access is limited by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
