# Copy to apps/api/.env and fill in. Never commit the real .env file.

# --- Server ---
PORT=4000
# Comma-separated list of web origins allowed by CORS
WEB_ORIGIN=http://localhost:3000

# --- Database (Prisma) ---
# Local development: Postgres from docker-compose.yml
DATABASE_URL=postgresql://postgres@localhost:5433/sports_booking
# Migrations need a direct (non-pooled) connection; locally it is the same database
DIRECT_URL=postgresql://postgres@localhost:5433/sports_booking
# Production values: Supabase Dashboard -> Connect -> ORMs -> Prisma
#   DATABASE_URL = Transaction pooler (port 6543) with ?pgbouncer=true
#   DIRECT_URL   = Session pooler (port 5432)

# --- Supabase (Auth + Storage) ---
# Supabase Dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# SERVER ONLY: this key bypasses Row Level Security. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Storage bucket for avatars and photos (Supabase Dashboard -> Storage)
SUPABASE_STORAGE_BUCKET=media
# Access tokens are verified with the project's public signing keys:
#   ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Only if the project still uses the legacy shared secret
# (Project Settings -> JWT Keys -> Legacy JWT Secret), uncomment and set:
# SUPABASE_JWT_SECRET=

# --- Email ---
# smtp = send through SMTP (Mailpit locally); log = write emails to the server log
EMAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="SportHub <no-reply@sporthub.local>"

# --- Scheduled jobs ---
# Shared secret that Supabase Cron sends to POST /api/jobs/reminders
CRON_SECRET=change-me-to-a-long-random-string
